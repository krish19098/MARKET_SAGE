# Copy to infra/.env (git-ignored). Never commit real values.
MARKET_SAGE_ENV=prod
MARKET_SAGE_DATABASE_URL=postgresql+psycopg://market_sage:CHANGE_ME@db/market_sage
POSTGRES_PASSWORD=CHANGE_ME
MARKET_SAGE_DATA_DIR=/data
MARKET_SAGE_EXECUTION_MODE=paper
# Auth: generate with `docker compose run --rm api market-sage hash-password`
MARKET_SAGE_AUTH_USERNAME=owner
MARKET_SAGE_AUTH_PASSWORD_HASH=
MARKET_SAGE_AUTH_TOTP_SECRET=
MARKET_SAGE_JWT_SECRET=
# Angel One SmartAPI (market data + read-only). Leave empty to run on fixtures/NSE files only.
MARKET_SAGE_ANGEL_API_KEY=
MARKET_SAGE_ANGEL_CLIENT_CODE=
MARKET_SAGE_ANGEL_PIN=
MARKET_SAGE_ANGEL_TOTP_SECRET=
# Web Push (VAPID): generate with `market-sage vapid-keys`
MARKET_SAGE_VAPID_PUBLIC_KEY=
MARKET_SAGE_VAPID_PRIVATE_KEY=
MARKET_SAGE_VAPID_SUBJECT=mailto:you@example.com
